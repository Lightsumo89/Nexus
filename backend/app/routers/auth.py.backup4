from datetime import datetime, timedelta
import hashlib
import secrets


from fastapi import APIRouter, Depends, HTTPException, Request, Response
from sqlalchemy import delete, select
from sqlalchemy.orm import Session

from .. import mailer
from ..config import settings
from ..db import get_db
from ..deps import COOKIE, get_user
from ..models import EmailToken, PendingRegistration, SessionRow, User, utcnow
from ..schemas import ForgotIn, LoginIn, ResetIn, ResendCodeIn, SignupIn, TokenIn, VerifyCodeIn
from ..security import DUMMY_HASH, digest, hash_password, new_token, verify_password

router = APIRouter(prefix="/auth", tags=["auth"])

def generate_verification_code() -> str:
    return f"{secrets.randbelow(1_000_000):06d}"


def hash_verification_code(code: str, salt: str) -> str:
    return hashlib.sha256(f"{salt}:{code}".encode()).hexdigest()


def send_registration_code(pending: PendingRegistration, code: str) -> None:
    mailer.send(
        pending.email,
        "Your verification code",
        f"Your verification code is {code}. It expires in 5 minutes.",
    )

def start_session(db: Session, user: User, response: Response) -> None:
    token, hashed = new_token()
    db.add(SessionRow(user_id=user.id, token_hash=hashed, expires_at=utcnow() + timedelta(days=settings.session_days)))
    db.commit()
    response.set_cookie(
        COOKIE,
        token,
        max_age=settings.session_days * 86400,
        httponly=True,
        secure=settings.cookie_secure,
        samesite="lax",
        path="/",
    )


def issue_email_token(db: Session, user: User, purpose: str, hours: int) -> str:
    token, hashed = new_token()
    db.add(EmailToken(user_id=user.id, token_hash=hashed, purpose=purpose, expires_at=utcnow() + timedelta(hours=hours)))
    db.commit()
    return token


def send_verification(db: Session, user: User) -> str:
    token = issue_email_token(db, user, "verify", 48)
    mailer.send(user.email, "Verify your email", f"Open http://localhost:5173/verify?token={token}")
    return token


@router.post("/signup", status_code=201)
def signup(body: SignupIn, db: Session = Depends(get_db)):
    if not body.is_adult:
        raise HTTPException(422, "You must be 18 or older to sign up")

    email = body.email.lower()

    if db.scalar(select(User).where(User.email == email)):
        raise HTTPException(409, "That email is already registered")

    now = utcnow()

    # Remove expired pending registrations before checking the email.
    db.execute(
        delete(PendingRegistration).where(PendingRegistration.expires_at <= now)
    )
    db.commit()

    existing_pending = db.scalar(
        select(PendingRegistration).where(PendingRegistration.email == email)
    )

    if existing_pending:
        raise HTTPException(
            409,
            "A registration is already pending for this email. Please use its verification code or wait for it to expire.",
        )

    registration_token = secrets.token_urlsafe(32)
    code = generate_verification_code()
    salt = secrets.token_hex(16)

    pending = PendingRegistration(
        registration_token_hash=digest(registration_token),
        email=email,
        password_hash=hash_password(body.password),
        is_adult_confirmed=True,
        accepted_agreement_at=now,
        code_hash=hash_verification_code(code, salt),
        code_salt=salt,
        code_expires_at=now + timedelta(minutes=5),
        resend_available_at=now + timedelta(seconds=30),
        expires_at=now + timedelta(minutes=15),
        failed_attempts=0,
    )

    db.add(pending)
    db.commit()

    send_registration_code(pending, code)

    result = {"ok": True, "registration_token": registration_token}
    if settings.env == "dev":
        result["dev_code"] = code

    return result


@router.post("/login")
def login(body: LoginIn, response: Response, db: Session = Depends(get_db)):
    user = db.scalar(select(User).where(User.email == body.email.lower()))
    if not user:
        verify_password(body.password, DUMMY_HASH)
        raise HTTPException(401, "Incorrect email or password")
    if not verify_password(body.password, user.password_hash) or user.status != "active":
        raise HTTPException(401, "Incorrect email or password")
    start_session(db, user, response)
    return {"ok": True}


@router.post("/logout")
def logout(request: Request, response: Response, db: Session = Depends(get_db)):
    token = request.cookies.get(COOKIE)
    if token:
        db.execute(delete(SessionRow).where(SessionRow.token_hash == digest(token)))
        db.commit()
    response.delete_cookie(COOKIE, path="/")
    return {"ok": True}


def consume(db: Session, token: str, purpose: str) -> EmailToken:
    row = db.scalar(
        select(EmailToken).where(
            EmailToken.token_hash == digest(token),
            EmailToken.purpose == purpose,
            EmailToken.used_at.is_(None),
            EmailToken.expires_at > utcnow(),
        )
    )
    if not row:
        raise HTTPException(400, "This link is invalid or has expired")
    row.used_at = utcnow()
    return row


@router.post("/verify")
def verify(
    body: VerifyCodeIn,
    response: Response,
    db: Session = Depends(get_db),
):
    now = utcnow()

    pending = db.scalar(
        select(PendingRegistration).where(
            PendingRegistration.registration_token_hash
            == digest(body.registration_token)
        )
    )

    if not pending or pending.expires_at <= now:
        if pending:
            db.delete(pending)
            db.commit()
        raise HTTPException(400, "Registration is invalid or has expired")

    if pending.code_expires_at <= now:
        raise HTTPException(400, "Verification code has expired. Request a new code.")

    if pending.failed_attempts >= 5:
        raise HTTPException(429, "Too many incorrect attempts. Request a new code.")

    expected_hash = hash_verification_code(body.code, pending.code_salt)

    if not secrets.compare_digest(expected_hash, pending.code_hash):
        pending.failed_attempts += 1
        db.commit()
        raise HTTPException(400, "Incorrect verification code")

    if db.scalar(select(User).where(User.email == pending.email)):
        db.delete(pending)
        db.commit()
        raise HTTPException(409, "That email is already registered")

    user = User(
        email=pending.email,
        password_hash=pending.password_hash,
        is_adult_confirmed=pending.is_adult_confirmed,
        email_verified_at=now,
    )

    db.add(user)
    db.flush()
    db.delete(pending)
    db.commit()
    db.refresh(user)

    start_session(db, user, response)

    return {"ok": True}


@router.post("/resend")
def resend(user: User = Depends(get_user), db: Session = Depends(get_db)):
    if user.email_verified_at:
        return {"ok": True}
    token = send_verification(db, user)
    return {"ok": True, **({"dev_verify_token": token} if settings.env == "dev" else {})}


@router.post("/forgot")
def forgot(body: ForgotIn, db: Session = Depends(get_db)):
    user = db.scalar(select(User).where(User.email == body.email.lower()))
    if user and user.status == "active":
        token = issue_email_token(db, user, "reset", 1)
        mailer.send(user.email, "Reset your password", f"Open http://localhost:5173/reset?token={token}")
    return {"ok": True}


@router.post("/reset")
def reset(body: ResetIn, db: Session = Depends(get_db)):
    row = consume(db, body.token, "reset")
    user = db.get(User, row.user_id)
    user.password_hash = hash_password(body.password)
    db.execute(delete(SessionRow).where(SessionRow.user_id == user.id))
    db.commit()
    return {"ok": True}
