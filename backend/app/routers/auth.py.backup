from datetime import timedelta

from fastapi import APIRouter, Depends, HTTPException, Request, Response
from sqlalchemy import delete, select
from sqlalchemy.orm import Session

from .. import mailer
from ..config import settings
from ..db import get_db
from ..deps import COOKIE, get_user
from ..models import EmailToken, SessionRow, User, utcnow
from ..schemas import ForgotIn, LoginIn, ResetIn, SignupIn, TokenIn
from ..security import DUMMY_HASH, digest, hash_password, new_token, verify_password

router = APIRouter(prefix="/auth", tags=["auth"])


def start_session(db: Session, user: User, response: Response) -> None:
    token, hashed = new_token()
    db.add(SessionRow(user_id=user.id, token_hash=hashed, expires_at=utcnow() + timedelta(days=settings.session_days)))
    db.commit()
    response.set_cookie(
        COOKIE,
        token,
        max_age=settings.session_days * 86400,
        httponly=True,
        secure=settings.cookie_secure,
        samesite="lax",
        path="/",
    )


def issue_email_token(db: Session, user: User, purpose: str, hours: int) -> str:
    token, hashed = new_token()
    db.add(EmailToken(user_id=user.id, token_hash=hashed, purpose=purpose, expires_at=utcnow() + timedelta(hours=hours)))
    db.commit()
    return token


def send_verification(db: Session, user: User) -> str:
    token = issue_email_token(db, user, "verify", 48)
    mailer.send(user.email, "Verify your email", f"Open http://localhost:5173/verify?token={token}")
    return token


@router.post("/signup", status_code=201)
def signup(body: SignupIn, response: Response, db: Session = Depends(get_db)):
    if not body.is_adult:
        raise HTTPException(422, "You must be 18 or older to sign up")
    email = body.email.lower()
    if db.scalar(select(User).where(User.email == email)):
        raise HTTPException(409, "That email is already registered")
    user = User(email=email, password_hash=hash_password(body.password), is_adult_confirmed=True)
    db.add(user)
    db.commit()
    token = send_verification(db, user)
    start_session(db, user, response)
    return {"ok": True, **({"dev_verify_token": token} if settings.env == "dev" else {})}


@router.post("/login")
def login(body: LoginIn, response: Response, db: Session = Depends(get_db)):
    user = db.scalar(select(User).where(User.email == body.email.lower()))
    if not user:
        verify_password(body.password, DUMMY_HASH)
        raise HTTPException(401, "Incorrect email or password")
    if not verify_password(body.password, user.password_hash) or user.status != "active":
        raise HTTPException(401, "Incorrect email or password")
    start_session(db, user, response)
    return {"ok": True}


@router.post("/logout")
def logout(request: Request, response: Response, db: Session = Depends(get_db)):
    token = request.cookies.get(COOKIE)
    if token:
        db.execute(delete(SessionRow).where(SessionRow.token_hash == digest(token)))
        db.commit()
    response.delete_cookie(COOKIE, path="/")
    return {"ok": True}


def consume(db: Session, token: str, purpose: str) -> EmailToken:
    row = db.scalar(
        select(EmailToken).where(
            EmailToken.token_hash == digest(token),
            EmailToken.purpose == purpose,
            EmailToken.used_at.is_(None),
            EmailToken.expires_at > utcnow(),
        )
    )
    if not row:
        raise HTTPException(400, "This link is invalid or has expired")
    row.used_at = utcnow()
    return row


@router.post("/verify")
def verify(body: TokenIn, db: Session = Depends(get_db)):
    row = consume(db, body.token, "verify")
    user = db.get(User, row.user_id)
    user.email_verified_at = utcnow()
    db.commit()
    return {"ok": True}


@router.post("/resend")
def resend(user: User = Depends(get_user), db: Session = Depends(get_db)):
    if user.email_verified_at:
        return {"ok": True}
    token = send_verification(db, user)
    return {"ok": True, **({"dev_verify_token": token} if settings.env == "dev" else {})}


@router.post("/forgot")
def forgot(body: ForgotIn, db: Session = Depends(get_db)):
    user = db.scalar(select(User).where(User.email == body.email.lower()))
    if user and user.status == "active":
        token = issue_email_token(db, user, "reset", 1)
        mailer.send(user.email, "Reset your password", f"Open http://localhost:5173/reset?token={token}")
    return {"ok": True}


@router.post("/reset")
def reset(body: ResetIn, db: Session = Depends(get_db)):
    row = consume(db, body.token, "reset")
    user = db.get(User, row.user_id)
    user.password_hash = hash_password(body.password)
    db.execute(delete(SessionRow).where(SessionRow.user_id == user.id))
    db.commit()
    return {"ok": True}
